<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>TUFReplay-Renderer</AssemblyName>
    <Version>0.1.0-beta.5</Version>
    <RootNamespace>TUFReplayRenderer</RootNamespace>
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);MSB3277</MSBuildWarningsAsMessages>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <GameDir Condition="'$(GameDir)' == ''">$(ADOFaiGameDir)</GameDir>
    <AdofaiManaged Condition="'$(AdofaiManaged)' == ''">$(GameDir)/A Dance of Fire and Ice_Data/Managed</AdofaiManaged>
    <ModManagerDir Condition="'$(ModManagerDir)' == ''">$(AdofaiManaged)/UnityModManager</ModManagerDir>
    <UnityModManagerDll Condition="'$(UnityModManagerDll)' == ''">$(ModManagerDir)/UnityModManager.dll</UnityModManagerDll>
    <HarmonyDll Condition="'$(HarmonyDll)' == ''">$(ModManagerDir)/0Harmony.dll</HarmonyDll>
    <AdofaiIpcDll Condition="'$(AdofaiIpcDll)' == ''">$(GameDir)/Mods/AdofaiIpc/AdofaiIpc.dll</AdofaiIpcDll>
  </PropertyGroup>
  <ItemGroup>
    <!-- Keep historical adapter sources available to their lifecycle fixtures,
         but compile only the shared overlay runtime into the shipped mod. -->
    <Compile Remove="Replay/OptionalModReplaySupport.cs;Replay/JipperResourcePackReplayAdapter.cs;Replay/GhostifyOverlayReplayAdapter.cs;Replay/OptionalOverlayPresentation.cs" />
    <Reference Include="$(AdofaiManaged)/UnityEngine*.dll"><Private>false</Private></Reference>
    <Reference Include="$(AdofaiManaged)/Assembly-CSharp.dll"><Private>false</Private></Reference>
    <Reference Include="$(AdofaiManaged)/Assembly-CSharp-firstpass.dll"><Private>false</Private></Reference>
    <Reference Include="$(AdofaiManaged)/RDTools.dll"><Private>false</Private></Reference>
    <Reference Include="$(AdofaiManaged)/Unity.Collections.dll"><Private>false</Private></Reference>
    <Reference Include="$(AdofaiManaged)/Unity.TextMeshPro.dll"><Private>false</Private></Reference>
    <Reference Include="$(AdofaiManaged)/DOTween.dll"><Private>false</Private></Reference>
    <Reference Include="$(AdofaiManaged)/SkyHook.Unity.dll"><Private>false</Private></Reference>
    <Reference Include="$(AdofaiManaged)/Newtonsoft.Json.dll"><Private>false</Private></Reference>
    <Reference Include="$(UnityModManagerDll)"><Private>false</Private></Reference>
    <Reference Include="$(HarmonyDll)"><Private>false</Private></Reference>
    <Reference Include="AdofaiIpc"><HintPath>$(AdofaiIpcDll)</HintPath><Private>false</Private></Reference>
    <EmbeddedResource Include="Engine/Localization/*.ftl" />
  </ItemGroup>
</Project>
