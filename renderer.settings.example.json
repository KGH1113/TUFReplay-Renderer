{
  "ffmpegExecutable": "/opt/homebrew/bin/ffmpeg",
  "defaults": {
    "outputDirectory": "/absolute/path/to/videos",
    "videoCodec": "H264",
    "encoder": "Software",
    "width": 1920,
    "height": 1080,
    "videoFps": 60,
    "simulationFps": 240,
    "includeDmNote": true
  },
  "dmNote": {
    "automaticPlacement": true,
    "viewerKind": "hand",
    "width": 640,
    "height": 240,
    "left": 0.0,
    "top": 0.75,
    "scale": 1.0
  }
}
